# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Public URL of the site (used for SEO links)
NEXT_PUBLIC_SITE_URL=https://kisskissfood.site

# WhatsApp number that customers write to, international format, digits only (example: 4917612345678).
# Leave empty until the dedicated WhatsApp Business number exists: the buttons then point to the contact section.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase project of Kiss Kiss Food (Project Settings → API). The publishable/anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://rsieepuhkocoklhfljmj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- WhatsApp bot (server only, never prefixed with NEXT_PUBLIC_) ---
# Supabase → Project Settings → API keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; type the same value in the Meta app when you set the webhook URL
WHATSAPP_VERIFY_TOKEN=
# Meta app → App settings → Basic → App secret
WHATSAPP_APP_SECRET=
